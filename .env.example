# Copy to .env for local runs outside docker-compose. Compose sets its own values.
# NONE of these are real secrets — generate fresh values for any deployment.

# Deployment context. Leave "development" locally. Set "production" (or "staging")
# on a deployed host — the app then refuses to boot on the dev-default
# ADMIN_TOKEN / SECRET_KEY below.
ENVIRONMENT=development

# Postgres connection. Render/Neon give postgres:// or postgresql://; the app
# rewrites the scheme to the psycopg3 driver automatically.
DATABASE_URL=postgresql+psycopg://llm:llm@localhost:5432/llmtracker

# Admin auth. ADMIN_TOKEN is the X-Admin-Token header value (curl / SDK / CI).
# ADMIN_USERNAME + ADMIN_PASSWORD back the login form. Empty password => login
# disabled locally; REQUIRED (>=12 chars) when ENVIRONMENT is deployed.
ADMIN_TOKEN=dev-admin-token
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# HMAC pepper for virtual-key hashing + admin session-cookie signing.
SECRET_KEY=dev-secret

# Public multi-tenant signup + abuse caps for the free DB.
ALLOW_SIGNUP=true
MAX_USERS=300
SIGNUPS_PER_IP_PER_HOUR=5
MAX_KEYS_PER_USER=10
MAX_USAGE_ROWS_PER_USER=4000
PLAYGROUND_REQUESTS_PER_HOUR=120

# Per-account live mode: a signed-in user attaches their own provider API key
# (encrypted, shown back as ····last4) on the Account page and their virtual keys
# can then make real upstream calls billed to that key, capped per month. The cap
# defaults to LIVE_CAP_DEFAULT_USD and can't be raised past LIVE_CAP_MAX_USD.
ALLOW_LIVE_KEYS=true
LIVE_CAP_DEFAULT_USD=5
LIVE_CAP_MAX_USD=10

# Let the Admin UI store provider API keys (AES-encrypted) in the DB. Convenience
# for local / non-prod only — HARD-BLOCKED when ENVIRONMENT is deployed.
ALLOW_DB_PROVIDER_KEYS=false
# Optional explicit Fernet key for that encryption (urlsafe-base64, 32 bytes).
# Empty => derived from SECRET_KEY.
ENCRYPTION_KEY=

# Local dev only: allow the Vite dev server origin. Leave empty in production.
CORS_ORIGINS=http://localhost:5173

# ---- provider credentials (server-side only; never in the DB or UI) ----
# Leave blank for the 100%-free simulated demo. Set a key to make that provider
# show as "configured" in the Admin panel and become eligible for live mode.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Master switch for real upstream calls. Keep false for the public demo — even
# when true, a request still needs key.allow_live + a configured & valid provider.
ENABLE_LIVE=false

# Seconds to cache a provider liveness check.
PROVIDER_CHECK_TTL=300
