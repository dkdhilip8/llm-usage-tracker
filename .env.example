# Copy to .env for local runs outside docker-compose. Compose sets its own values.
# NONE of these are real secrets — generate fresh values for any deployment.

# Deployment context. Leave "development" locally. Set "production" (or "staging")
# on a deployed host — the app then refuses to boot on the dev-default
# ADMIN_TOKEN / SECRET_KEY below.
ENVIRONMENT=development

# Postgres connection. Render/Neon give postgres:// or postgresql://; the app
# rewrites the scheme to the psycopg3 driver automatically.
DATABASE_URL=postgresql+psycopg://llm:llm@localhost:5432/llmtracker

# Shared secret for the admin API (create/list/revoke keys, provider status).
ADMIN_TOKEN=dev-admin-token

# HMAC pepper for virtual-key hashing.
SECRET_KEY=dev-secret

# Local dev only: allow the Vite dev server origin. Leave empty in production.
CORS_ORIGINS=http://localhost:5173

# ---- provider credentials (server-side only; never in the DB or UI) ----
# Leave blank for the 100%-free simulated demo. Set a key to make that provider
# show as "configured" in the Admin panel and become eligible for live mode.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Master switch for real upstream calls. Keep false for the public demo — even
# when true, a request still needs key.allow_live + a configured & valid provider.
ENABLE_LIVE=false

# Seconds to cache a provider liveness check.
PROVIDER_CHECK_TTL=300
